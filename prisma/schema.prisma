// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  plan         Plan     @default(pending)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Stripe integration
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(incomplete)
  subscriptionPriceId  String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  // Usage tracking (minutes-based)
  minutesUsed    Int       @default(0) // Minutes used in current period
  minutesLimit   Int       @default(0) // Total minutes allowed (plan + credits)
  bonusMinutes   Int       @default(0) // Extra purchased minutes
  lastUsageReset DateTime? // When usage was last reset

  sessions           Session[]
  apiKeys            ApiKey[]
  agentApiKeys       AgentApiKey[]
  reviews            Review[]
  generatedVideos    GeneratedVideo[]
  actorPresets       ActorPreset[]
  webhooks           Webhook[]
  creditPurchases    CreditPurchase[]
  falCompositeVideos FalCompositeVideo[]

  // Website2ads
  emailVerifiedAt DateTime?
  adsMemberships  AdsWorkspaceMember[]
  adRuns          AdRun[]

  @@index([email])
  @@index([plan])
  @@index([stripeCustomerId])
  @@index([subscriptionStatus])
}

enum Plan {
  free // Legacy - treat same as pending
  pending // User registered but hasn't subscribed
  starter // 3 minutes/month
  pro // 20 minutes/month
  enterprise // 60 minutes/month
}

enum SubscriptionStatus {
  incomplete // Checkout started but not completed
  incomplete_expired // Checkout expired
  trialing // In trial period
  active // Subscription is active
  past_due // Payment failed but not yet canceled
  canceled // Subscription was canceled
  unpaid // Invoice unpaid
  paused // Subscription paused
}

model CreditPurchase {
  id              String   @id @default(cuid())
  userId          String
  stripePaymentId String   @unique
  minutes         Int // Minutes purchased
  amountPaid      Int // Amount in cents
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripePaymentId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

/// Personal API keys for agents (Claude Code, Cursor, the komendly CLI, hosted MCP). Only the sha256 is stored.
/// (The older `ApiKey` model below is a legacy, unused vendor-key table.)
model AgentApiKey {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  name        String
  prefix      String // first 12 chars ("kmd_" + 8), for display
  keyHash     String    @unique // sha256 hex of the full key
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String   @unique
  service   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
  @@index([service])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  businessName String
  reviewerName String
  reviewText   String
  rating       Int
  source       String
  createdAt    DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedVideos    GeneratedVideo[]
  falCompositeVideos FalCompositeVideo[]

  @@index([userId])
  @@index([source])
  @@index([rating])
}

model GeneratedVideo {
  id           String      @id @default(cuid())
  userId       String
  reviewId     String
  url          String?
  thumbnailUrl String?
  avatarStyle  String
  duration     Int?
  aspectRatio  String      @default("9:16")
  status       VideoStatus @default(pending)
  createdAt    DateTime    @default(now())
  completedAt  DateTime?

  // Mirage/Captions.ai specific fields
  mirageOperationId String? @unique // Operation ID for polling
  mirageCreatorName String? // AI Creator used
  mirageResolution  String? @default("4k")
  generatedScript   String? // AI-generated UGC script
  creditsUsed       Int? // Mirage credits consumed
  errorMessage      String? // Error details if failed

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reviewId])
  @@index([status])
  @@index([mirageOperationId])
  @@index([userId, status])
}

enum VideoStatus {
  pending
  processing
  completed
  failed
}

model ActorPreset {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  avatarStyle    String
  category       String // "male", "female", "neutral"
  ethnicity      String?
  ageGroup       String? // "young-adult", "adult", "middle-aged", "senior"
  voiceSettings  Json // VoiceSettings object
  visualSettings Json // VisualSettings object
  thumbnailUrl   String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([category])
}

model Webhook {
  id              String      @id @default(cuid())
  userId          String
  name            String // Friendly name for the webhook
  type            WebhookType @default(custom)
  webhookUrl      String
  events          String[] // Array of event types: ["video.completed", "video.failed", etc.]
  active          Boolean     @default(true)
  secret          String? // Optional secret for signature verification
  metadata        Json? // Additional configuration (e.g., Slack channel, Discord settings)
  lastTriggeredAt DateTime?
  failureCount    Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, active])
  @@index([type])
  @@index([active])
}

enum WebhookType {
  slack
  discord
  email
  custom
}

// ============================================================================
// FAL AI Lip-Sync Video Generation (SadTalker)
// ============================================================================

model FalActor {
  id                String   @id @default(cuid())
  name              String // Display name: "Sarah - Professional"
  slug              String   @unique // URL-friendly: "sarah-professional"
  gender            String // "male", "female"
  style             String // "professional", "casual", "energetic", "friendly"
  referenceImageUrl String // Front-facing pose for SadTalker consistency
  thumbnailUrl      String // Preview image for UI grid
  voiceId           String? // OpenAI TTS voice: "alloy", "nova", "shimmer", etc.
  voicePrompt       String? // Detailed voice description for VEO consistency (pitch, tone, accent, pace)
  description       String? // Optional description for the actor
  // Consistent identity + selection (testimonial engine)
  voiceProvider     String? // TTS provider for voiceId, e.g. "fal" (audio-driven pipeline)
  voiceSettings     Json? // Provider voice params (speed, pitch, emotion...) fixed per actor
  ageRange          String? // "25-34"
  persona           String? // "busy mom", "small business owner"
  occupation        String?
  setting           String? // "car", "kitchen", "office", ...
  tags              String[] @default([])
  industries        String[] @default([])
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  compositeVideos FalCompositeVideo[]

  @@index([isActive])
  @@index([gender])
  @@index([style])
  @@index([sortOrder])
}

model FalCompositeVideo {
  id       String @id @default(cuid())
  userId   String
  reviewId String
  actorId  String

  // Scripts
  fullScript        String // Complete generated script
  hookScript        String // Hook portion (5-6s)
  testimonialScript String // Main testimonial (10-20s)
  ctaScript         String // Call to action (5-6s)

  // Configuration
  aspectRatio    String @default("9:16")
  targetDuration Int // Total target duration in seconds (20-35)
  voiceId        String @default("nova") // OpenAI TTS voice used

  // Output
  finalVideoUrl  String?
  thumbnailUrl   String?
  actualDuration Int? // Actual duration after generation

  // Status tracking
  status       FalCompositeStatus @default(pending)
  currentClip  Int                @default(0) // Which clip is being generated
  totalClips   Int                @default(3) // Total clips to generate
  errorMessage String?

  // Engine pipeline (testimonial_generate job)
  pipeline        String? // "native_speech" | "audio_driven"
  modelConfig     Json? // snapshot of the model config used
  pipelineState   Json? // engine checkpoints (script, audio, clip plan) for idempotent retries
  scriptSource    String? // "codex" | "template" | "custom"
  jobId           String? // AdJob id
  costMicros      BigInt  @default(0) // estimated vendor cost
  minutesReserved Int     @default(0)
  minutesCharged  Int     @default(0)
  minutesState    String  @default("none") // none | reserved | charged | released

  // Timestamps
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor  FalActor  @relation(fields: [actorId], references: [id])
  clips  FalClip[]

  @@index([userId])
  @@index([reviewId])
  @@index([actorId])
  @@index([status])
  @@index([userId, status])
}

model FalClip {
  id               String @id @default(cuid())
  compositeVideoId String
  clipType         String // "hook", "testimonial", "cta"
  clipIndex        Int // Order within composite (0, 1, 2, ...)
  scriptContent    String // The text for this clip

  // TTS tracking
  audioUrl String? // URL of generated TTS audio

  // FAL SadTalker tracking
  falRequestId String? @unique // FAL request ID for polling

  // Output
  videoUrl String? // URL of generated video clip
  duration Int? // Actual duration in seconds

  // Engine pipeline
  deliveryDirection String? // per-clip delivery note (tone/pace, never appearance)
  startMs           Int? // audio-driven: chunk offsets in the full script audio
  endMs             Int?
  costMicros        BigInt  @default(0)

  // Status
  status       String  @default("pending") // pending, generating_audio, generating_video, completed, failed
  errorMessage String?

  // Timestamps
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  compositeVideo FalCompositeVideo @relation(fields: [compositeVideoId], references: [id], onDelete: Cascade)

  @@index([compositeVideoId])
  @@index([falRequestId])
  @@index([status])
}

enum FalCompositeStatus {
  pending // Initial state
  generating_clips // Clips being generated (TTS + SadTalker)
  stitching // FFmpeg combining clips
  completed
  failed
}

// ============================================================================
// Website2ads (komendly.com/ads) — multi-tenant website-to-ad SaaS
// Shared by the Next.js web app and the Railway generation engine (engine/).
// ============================================================================

model AdsWorkspace {
  id                   String    @id @default(cuid())
  name                 String
  ownerId              String
  creditBalance        Int       @default(0) // cached; CreditLedger is the source of truth
  trialUsedAt          DateTime?
  studioFreeVideos     Int       @default(1) // Ozzy Studio: free finished videos left (1 per new workspace; +1 per studio referral reward; +2 for invited friends)
  studioOfferReadyAt   DateTime? // first free Studio video delivered -> 72h Studio launch offer window starts
  // Billing (monthly plan with included credits + top-ups)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  adsPlan              String    @default("trial") // trial | starter | growth | scale (placeholder tiers)
  subscriptionStatus   String    @default("none")
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  suspendedAt          DateTime? // abuse suspension
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members        AdsWorkspaceMember[]
  studioSessions StudioSession[]
  brandProfiles  BrandProfile[]
  runs           AdRun[]
  ads            Ad[]
  ledger         CreditLedger[]
  abuseFlags     AbuseFlag[]
  refunds        AdsRefund[]
  metaConnection MetaConnection?
  autopilot      AdsAutopilot?

  @@index([ownerId])
  @@index([adsPlan])
}

/// Ozzy Autopilot settings (one row per workspace; missing row = defaults: on, Monday 9am, with video).
model AdsAutopilot {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  enabled        Boolean   @default(true)
  focus          String? // one sentence steering this week's drop, e.g. "push the Black Friday sale"
  focusUpdatedAt DateTime?
  dayOfWeek      Int       @default(1) // 1 = Monday .. 7 = Sunday (workspace time zone)
  hour           Int       @default(9) // 0-23 local
  timezone       String? // IANA; null = US Eastern
  includeVideo   Boolean   @default(true) // also make one Studio video each week
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace AdsWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AdsWorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner") // owner | admin | member
  createdAt   DateTime @default(now())

  workspace AdsWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Persistent brand profile (one per site per workspace). Facts carry source URLs.
model BrandProfile {
  id          String   @id @default(cuid())
  workspaceId String
  domain      String
  url         String
  name        String?
  // Visual identity
  colors      Json     @default("[]") // [{hex, role: primary|secondary|accent|bg|text}]
  fonts       Json     @default("[]") // [{family, role: heading|body, sourceUrl?}]
  logoKey     String? // storage key
  assets      Json     @default("[]") // [{key, sourceUrl, kind: product|screenshot|photo|illustration|icon, width, height, hasFace}]
  // Strategy (extracted, user-correctable)
  audience    String?
  mainOffer   String?
  pains       Json     @default("[]") // [{text, sourceUrl, quote?}]
  proof       Json     @default("[]") // [{text, sourceUrl, kind: testimonial|stat|logo|award}]
  facts       Json     @default("[]") // allowed claims: [{claim, sourceUrl, quote}]
  landingPage String?
  voice       String?
  userEdited  Json     @default("{}") // which fields the user corrected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace AdsWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AdRun[]

  @@unique([workspaceId, domain])
}

enum AdRunStatus {
  extracting
  awaiting_confirm // 30-second confirm window
  queued
  generating
  completed
  partial // some ads failed QC/generation; credits for those released
  failed
  canceled
}

enum AdGoal {
  leads
  sales
  awareness
  traffic
  app_installs
  auto
}

model AdRun {
  id              String      @id @default(cuid())
  workspaceId     String
  userId          String
  brandProfileId  String?
  url             String
  goal            AdGoal      @default(auto)
  resolvedGoal    AdGoal?
  status          AdRunStatus @default(extracting)
  isTrial         Boolean     @default(false)
  kind            String      @default("standard") // standard | gift (3 statics for someone else's site: no credits, no trial claim, auto-confirm)
  extractAttempts Int         @default(0)
  extraction      Json? // snapshot shown on confirm screen
  corrections     Json? // user edits applied before generation
  awarenessMix    Json? // e.g. {"problem_aware":7,"solution_aware":3}
  ratios          String[]    @default(["1:1"]) // trial: 1:1 ; paid: any of 4:5,1:1,9:16
  staticCount     Int         @default(10)
  motionCount     Int         @default(1)
  creditsReserved Int         @default(0)
  creditsCharged  Int         @default(0)
  confirmDeadline DateTime?
  confirmedAt     DateTime?
  firstAdAt       DateTime? // time-to-first-ad = firstAdAt - confirmedAt
  completedAt     DateTime?
  costMicros      BigInt      @default(0) // measured provider cost (USD micros, est. for subscription)
  error           String?
  clientIpHash    String?
  deviceHash      String?
  trialClaim      Json? // trial claim hashes (TrialClaimHashes), so the engine can claim on auto-confirm
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace    AdsWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  ads          Ad[]
  jobs         AdJob[]

  @@index([workspaceId, createdAt])
  @@index([status])
}

enum AwarenessLevel {
  unaware
  problem_aware
  solution_aware
  product_aware
  most_aware
}

enum AdKind {
  static
  motion
}

enum AdStatus {
  planned
  rendering
  qc
  ready
  failed_qc
  failed
}

model Ad {
  id          String         @id @default(cuid())
  runId       String
  workspaceId String
  kind        AdKind         @default(static)
  index       Int // order within run
  awareness   AwarenessLevel
  angle       String // distinct idea, one line
  hook        String // opening moment / private thought in buyer's words
  headline    String
  body        String?
  cta         String?
  claims      Json           @default("[]") // [{claim, factRef/sourceUrl}] — every claim must map to a BrandProfile fact
  visualBrief Json?
  status      AdStatus       @default(planned)
  qcAttempts  Int            @default(0)
  qcReport    Json? // {pass, checks:[{name, pass, detail}]}
  costMicros  BigInt         @default(0)
  durationMs  Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  run       AdRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  workspace AdsWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    AdAsset[]
  publishes MetaPublish[]

  @@index([runId])
  @@index([workspaceId, createdAt])
}

model AdAsset {
  id         String    @id @default(cuid())
  adId       String
  ratio      String // "4:5" | "1:1" | "9:16"
  storageKey String
  mime       String // image/png | image/jpeg | video/mp4
  width      Int
  height     Int
  bytes      Int
  expiresAt  DateTime? // temporary storage TTL (null = kept with brand profile)
  createdAt  DateTime  @default(now())

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([expiresAt])
}

enum AdJobStatus {
  queued
  running
  succeeded
  failed // will retry if attempts < maxAttempts
  dead // exhausted retries -> admin "failed jobs"
  canceled
}

// Postgres-backed queue. Engine claims with FOR UPDATE SKIP LOCKED.
model AdJob {
  id          String      @id @default(cuid())
  type        String // extract | plan | render_static | render_motion | qc | publish_meta | cleanup
  runId       String?
  adId        String?
  workspaceId String?
  payload     Json        @default("{}")
  result      Json?
  status      AdJobStatus @default(queued)
  priority    Int         @default(0) // higher first; paid > trial
  runAt       DateTime    @default(now())
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)
  lockedBy    String?
  lockedAt    DateTime?
  lastError   String?
  costMicros  BigInt      @default(0)
  durationMs  Int?
  createdAt   DateTime    @default(now())
  finishedAt  DateTime?

  run AdRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, priority, runAt])
  @@index([runId])
  @@index([type, status])
}

enum CreditReason {
  trial_grant
  subscription_grant
  topup
  reserve
  release
  refund
  admin_adjust
  expire
  referral_reward // Give 10, get 10: expires (CreditLedger.expiresAt)
  studio_charge // Ozzy Studio render charge (stripeRef studio:<renderId>)
  offer_bonus // one-time bonus credits from an offer (e.g. studio_launch)
}

// Append-only credit ledger. creditBalance on workspace is derived from it.
model CreditLedger {
  id           String       @id @default(cuid())
  workspaceId  String
  delta        Int
  balanceAfter Int
  reason       CreditReason
  runId        String?
  stripeRef    String?      @unique // idempotency for webhooks (invoice/payment id)
  note         String?
  actorId      String? // admin user for adjustments/refunds
  expiresAt    DateTime? // referral_reward grants only: unused remainder expires then (sweep writes reason=expire, stripeRef expire:<ledgerId>)
  createdAt    DateTime     @default(now())

  workspace AdsWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// One free trial per domain / device / IP / email.
model AdsTrialClaim {
  id          String   @id @default(cuid())
  workspaceId String
  domainHash  String
  ipHash      String?
  deviceHash  String?
  emailHash   String
  createdAt   DateTime @default(now())

  @@index([domainHash])
  @@index([ipHash])
  @@index([deviceHash])
  @@index([emailHash])
}

model AbuseFlag {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String?
  kind        String // trial_farming | disposable_email | rate_limit | blocked_content | payment_fraud | prompt_injection
  severity    String    @default("low") // low | medium | high
  details     Json      @default("{}")
  status      String    @default("open") // open | dismissed | actioned
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace AdsWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AdsRefund {
  id             String   @id @default(cuid())
  workspaceId    String
  stripeRefundId String?  @unique
  amountCents    Int
  credits        Int      @default(0)
  reason         String?
  actorId        String
  createdAt      DateTime @default(now())

  workspace AdsWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Funnel analytics: trial_started, extraction_shown, run_confirmed, first_ad_ready,
// run_completed, export_downloaded, checkout_started, paid_converted, churned.
model AdsEvent {
  id          String   @id @default(cuid())
  name        String
  workspaceId String?
  userId      String?
  runId       String?
  props       Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([workspaceId])
}

// Engine/provider health (e.g. Codex login expired) surfaced in admin.
model EngineHeartbeat {
  id        String   @id // worker id or "provider:codex"
  kind      String // worker | provider
  ok        Boolean
  message   String?
  meta      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model AdsFeatureFlag {
  key       String   @id // ezmotion | meta_publish
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Meta publishing integration (paid users only). Tokens encrypted at rest.
model MetaConnection {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  encryptedToken String
  tokenExpiresAt DateTime?
  adAccountId    String?
  pageId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace AdsWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MetaPublish {
  id          String   @id @default(cuid())
  adId        String
  status      String   @default("pending") // pending | published | failed
  metaAdId    String?
  campaignId  String?
  error       String?
  jobId       String? // AdJob that publishes this row
  ratio       String? // 4:5 | 1:1 | 9:16
  adSetId     String?
  adAccountId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([jobId])
}

// Server-side OAuth state + PKCE verifier for connecting Meta (short-lived, single use).
model MetaOAuthState {
  state        String   @id
  workspaceId  String
  userId       String
  mode         String // mcp | graph
  codeVerifier String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

// Email verification for the /ads free trial (token stored as sha256 hash; expires).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Postgres-backed sliding-window rate limiter (billing/abuse worker). One row per hit.
model AdsRateLimit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// Growth loops: referrals (Give 10, get 10), gift packs, partners, ad of the week
// ---------------------------------------------------------------------------

/// One share code per workspace (customers and partners). Link: /r/<code>.
model AdsReferralCode {
  id          String   @id @default(cuid())
  code        String   @unique // short, url-safe, e.g. "sarah-k3x9"
  workspaceId String   @unique
  userId      String
  kind        String   @default("customer") // customer | partner
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// A referred sign-up. Referred friend gets a 20-ad trial; referrer gets 10 credits (30-day expiry) when the friend's trial finishes.
model AdsReferral {
  id                  String    @id @default(cuid())
  code                String
  referrerWorkspaceId String
  referredWorkspaceId String    @unique
  referredUserId      String
  source              String    @default("link") // link | gift | partner
  giftId              String?
  status              String    @default("signed_up") // signed_up | trial_done | rewarded | paid | rejected
  rejectReason        String? // self_referral | same_network | monthly_cap | ...
  trialDoneAt         DateTime?
  rewardedAt          DateTime?
  rewardCredits       Int       @default(0)
  rewardLedgerId      String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([referrerWorkspaceId, createdAt])
  @@index([code])
}

/// Free 3-ad "gift pack" made for another business's website. Public link: /gift/<token>.
model AdsGift {
  id                  String    @id @default(cuid())
  token               String    @unique
  senderWorkspaceId   String
  senderUserId        String
  senderName          String // shown as "<senderName> made you these"
  recipientUrl        String
  recipientDomainHash String
  recipientName       String?
  note                String?
  source              String // trial_ready | paid_monthly | partner_demo | admin_outreach
  runId               String?   @unique // AdRun.kind = gift
  status              String    @default("pending") // pending | generating | ready | failed
  viewedAt            DateTime?
  viewCount           Int       @default(0)
  claimedAt           DateTime?
  claimedWorkspaceId  String?
  costMicros          BigInt    @default(0)
  /// Kly "encore": 2 more ads Ozzy draws live when a real person opens an outbound gift (a second AdRun kind=gift).
  extraRunId          String?   @unique
  extraCostMicros     BigInt    @default(0) // part of the encore run's cost already credited to the Kly lead
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([senderWorkspaceId, createdAt])
  @@index([recipientDomainHash])
  @@index([status])
}

/// Partner program (web designers, freelancers, agencies): 30% of referred payments for 12 months.
model AdsPartner {
  id                String    @id @default(cuid())
  userId            String    @unique
  workspaceId       String    @unique
  status            String    @default("applied") // applied | approved | rejected | paused
  company           String?
  website           String?
  role              String? // web designer | freelancer | agency | other
  clientCount       Int?
  pitch             String? // how they plan to share it
  payoutEmail       String?
  payoutMethod      String? // paypal | wise | bank | other
  commissionPct     Int       @default(30)
  commissionMonths  Int       @default(12)
  demoGiftsPerMonth Int       @default(3)
  approvedAt        DateTime?
  adminNote         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
}

/// One row per paid invoice of a partner-referred workspace. Payable after the 30-day refund window; paid manually by admin.
model AdsCommission {
  id                  String    @id @default(cuid())
  partnerId           String
  referredWorkspaceId String
  stripeInvoiceId     String    @unique // or checkout/payment id for one-time payments
  amountCents         Int
  commissionCents     Int
  status              String    @default("pending") // pending | payable | paid | void
  availableAt         DateTime // amount becomes payable (refund window passed)
  paidAt              DateTime?
  payoutRef           String?
  voidReason          String?
  createdAt           DateTime  @default(now())

  @@index([partnerId, status])
  @@index([referredWorkspaceId])
}

/// Ad of the week: user consent to feature an ad on Komendly's socials (tagging their handle).
model AdsFeature {
  id          String    @id @default(cuid())
  adId        String    @unique
  workspaceId String
  userId      String
  consentAt   DateTime  @default(now())
  handle      String? // @instagram / facebook page to tag
  brandName   String?
  status      String    @default("consented") // consented | shortlisted | featured | declined | withdrawn
  featuredAt  DateTime?
  postUrl     String?
  caption     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Ozzy Studio: conversational motion graphics / video ads / footage editing (goal ezmotionkom).
// Web <-> engine only through these rows (no HTTP). Contract: src/lib/studio/contracts.ts.
// ---------------------------------------------------------------------------

/// One chat thread with Ozzy (= one video project). The engine keeps the agent session + project files in S3 between turns.
model StudioSession {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  title          String    @default("New video")
  status         String    @default("idle") // idle | queued | working | awaiting_user | error
  model          String    @default("gpt-6.1-sol")
  thinking       String    @default("high")
  projectKey     String? // S3 key of the project snapshot (tar.gz) after the last turn
  agentStateKey  String? // S3 key of the serialized agent session after the last turn
  freeVideo      Boolean   @default(false) // this session spends the workspace's free video (watermarked)
  starterId      String? // starter prompt id used to open it
  autopilotWeek  String? // Ozzy Autopilot weekly video ("2026-W47"); never charged
  lastActivityAt DateTime  @default(now())
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace AdsWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  StudioMessage[]
  events    StudioEvent[]
  renders   StudioRender[]
  uploads   StudioUpload[]

  @@unique([workspaceId, autopilotWeek])
  @@index([workspaceId, lastActivityAt])
  @@index([userId])
}

/// A chat message. Assistant messages stream: the engine appends StudioEvent rows and writes the final content when done.
model StudioMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String // user | assistant
  content     String   @default("")
  attachments Json     @default("[]") // user: [{uploadId}] ; assistant: [{renderId}] | [{question}]
  status      String   @default("done") // queued | streaming | done | error | cancelled
  jobId       String? // AdJob studio_turn for assistant messages
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// Append-only stream of what Ozzy is doing (text deltas, tool steps, previews). The web SSE route tails it by id.
model StudioEvent {
  id        BigInt   @id @default(autoincrement())
  sessionId String
  messageId String?
  type      String // see STUDIO_EVENT_TYPES
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  session StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
}

/// User footage / images uploaded straight to S3 (presigned PUT), probed by the engine.
model StudioUpload {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  sessionId   String?
  key         String   @unique
  filename    String
  mime        String
  bytes       Int
  durationSec Float?
  width       Int?
  height      Int?
  posterKey   String?
  status      String   @default("pending") // pending | uploaded | ready | failed
  createdAt   DateTime @default(now())

  session StudioSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([sessionId])
}

/// A finished, delivered video version from a Studio session.
model StudioRender {
  id             String   @id @default(cuid())
  sessionId      String
  messageId      String?
  workspaceId    String
  version        Int
  key            String // mp4 in S3
  posterKey      String?
  ratio          String // 9:16 | 4:5 | 1:1 | 16:9
  seconds        Float
  width          Int
  height         Int
  watermarked    Boolean  @default(false)
  free           Boolean  @default(false)
  kind           String   @default("new") // new | revision
  creditsCharged Int      @default(0)
  shareToken     String?  @unique // public /s/<token> share page (viral loop)
  shareViews     Int      @default(0)
  costMicros     BigInt   @default(0)
  createdAt      DateTime @default(now())

  session StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, version])
  @@index([workspaceId, createdAt])
}

/// "Give 2 free Studio videos": invite link /studio/invite/<token>. Friend gets 2 free videos at sign-up; sender +1 free video.
model StudioInvite {
  id                 String    @id @default(cuid())
  token              String    @unique
  senderWorkspaceId  String
  senderUserId       String
  email              String? // optional: invite emailed by Ozzy
  status             String    @default("sent") // sent | claimed | rewarded | rejected
  rejectReason       String? // self | same_network | monthly_cap | existing_user
  claimedWorkspaceId String?   @unique
  claimedUserId      String?
  claimedAt          DateTime?
  rewardedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([senderWorkspaceId, createdAt])
}

/// Cold outbound ("I made you a free ad"): engine-run, OUTBOUND_ENABLED=0 by default. Mailboxes come from the
/// OUTBOUND_MAILBOXES env (JSON: address, name, user, appPassword); this row holds only state, never the password.
model OutboundMailbox {
  id              String    @id @default(cuid())
  address         String    @unique
  displayName     String
  smtpHost        String    @default("smtp.gmail.com")
  smtpPort        Int       @default(465)
  smtpUser        String
  imapHost        String    @default("imap.gmail.com")
  imapPort        Int       @default(993)
  secretRef       String    @default("env:OUTBOUND_MAILBOXES") // "env:OUTBOUND_MAILBOXES" (password in env) or "db" (secretEnc)
  /// AES-256-GCM sealed password (ADS_TOKEN_KEY, crypto.ts format) for DB-stored mailboxes; null = env mailbox.
  secretEnc       String?
  provider        String    @default("gmail") // gmail | maildoso | smtp
  /// Sending domain (lowercased part after @); rotation + per-domain caps + domain health.
  domain          String?
  /// No cold sends before this (Maildoso: created + 14 days of vendor warm-up). Null = ready now.
  readyAt         DateTime?
  /// Vendor's own id (Maildoso account id) + status, for idempotent syncs.
  vendorId        String?
  vendorStatus    String?
  dailyCap        Int       @default(40)
  warmupStartedAt DateTime  @default(now())
  paused          Boolean   @default(false)
  pausedReason    String?
  lastSentAt      DateTime?
  lastPolledAt    DateTime?
  imapLastUid     Int       @default(0)
  sentTotal       Int       @default(0)
  bouncedTotal    Int       @default(0)
  complainedTotal Int       @default(0)
  repliedTotal    Int       @default(0)
  /// Kly peer warm-up (kly/src/warmup.ts): per-mailbox opt-out, first warm-up send, last IMAP engagement pass,
  /// first cold send (drives the 5 -> 10 -> 15 cold ramp).
  warmupEnabled   Boolean   @default(true)
  warmupSince     DateTime?
  warmupPolledAt  DateTime?
  coldStartedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sends OutboundSend[]

  @@index([domain])
}

/// One sending domain of the outbound mailboxes: per-domain daily cap + DNS / blocklist health (Kly checks it periodically
/// and pauses every mailbox on it while it is listed or its DNS is broken).
model OutboundDomain {
  domain       String    @id
  dailyCap     Int       @default(45)
  capAuto      Boolean   @default(true) // Kly raises/cuts dailyCap once a day on health; false = admin-fixed
  capCheckedAt DateTime?
  paused       Boolean   @default(false)
  pausedReason String? // "auto: ..." lifts itself on a clean check; anything else is an admin pause
  dkimSelector String?
  mxOk         Boolean?
  spfOk        Boolean?
  dkimOk       Boolean?
  dmarcOk      Boolean?
  listedOn     String[]  @default([])
  failStreak   Int       @default(0)
  checkNote    String?
  checkedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// One lead-finding request (admin page / CLI / engine): niche + cities + count. The engine claims pending rows.
model OutboundRun {
  id        String   @id @default(cuid())
  niche     String
  cities    String[]
  count     Int
  status    String   @default("pending") // pending | running | done | failed
  found     Int      @default(0)
  result    Json?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model OutboundLead {
  id            String    @id @default(cuid())
  runId         String?
  businessName  String
  website       String
  domain        String    @unique // registrable domain: dedupe key
  niche         String
  city          String
  region        String?
  timezone      String    @default("America/New_York")
  email         String // public business address found on the business's own site
  emailFoundOn  String // page URL it was found on
  source        String    @default("osm") // osm | search | codex_search | manual
  /// found -> ad_made -> queued -> sent -> opened -> clicked -> replied -> signed_up -> paid | bounced | unsubscribed | complained | failed
  status        String    @default("found")
  giftId        String?   @unique
  giftToken     String?   @unique
  adId          String?
  claimToken    String    @unique
  unsubToken    String    @unique
  mailboxId     String?
  step          Int       @default(0) // emails sent (max 2: first + one follow-up)
  nextSendAt    DateTime?
  lastSentAt    DateTime?
  clickedAt     DateTime?
  repliedAt     DateTime?
  error         String?
  // Kly (acquisition service) fields
  score         Int? // 0-100 fit score from qualification
  qualification Json? // { isLocalSmb, sellsToConsumers, chain, reasons[] } from the qualifier
  qualityScore  Int? // 0-10 judge score of the hook ad (Kly's auto review)
  qualityNotes  String?
  giftAttempts  Int       @default(0) // hook-ad generations tried (regenerate once on a weak ad)
  armIds        String[]  @default([]) // KlyArm ids this lead was assigned (subject, body, angle, ...)
  replyIntent   String? // interested | question | not_now | not_interested | unsubscribe | auto_reply | other
  userId        String? // Komendly user that signed up from this lead
  workspaceId   String?
  signedUpAt    DateTime?
  paidAt        DateTime?
  revenueCents  Int       @default(0) // lifetime paid revenue from the converted workspace
  costMicros    BigInt    @default(0) // AI + generation cost attributed to this lead
  purgedAt      DateTime? // PII removed by retention (row kept for stats)
  // Voice bridge (Kly -> The Tribunal AI calls)
  phone         String? // US E.164 business phone (+1XXXXXXXXXX)
  phoneSource   String? // osm | site | codex_search (third-party listing, used only when the own site has none) | reply
  /// queued | rejected | called | gift_yes | info_requested | not_interested | opt_out | callback_requested | no_answer | failed ...
  voiceStatus   String?
  voiceReason   String? // Tribunal reject reason / last event detail
  voiceSyncedAt DateTime? // suppression pushed to Tribunal (null while one is pending)
  calledAt      DateTime?
  voicePushedAt DateTime? // handed to The Tribunal (daily call cap counts these)
  voiceDelivery     String? // v1.1: delivery asked for on the call ("sms" | "email")
  voiceSmsPhone     String? // v1.1: number to text the gift to
  voiceDeliveredAt  DateTime? // gift link delivered after the call (exactly once)
  voiceDeliveredVia String? // sms | email
  voiceSmsFailedAt  DateTime? // first failed SMS attempt (retried for 24 h when no email fallback)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sends OutboundSend[]

  @@index([status, nextSendAt])
  @@index([runId])
  @@index([workspaceId])
  @@index([niche, city])
}

model OutboundSend {
  id           String          @id @default(cuid())
  leadId       String
  lead         OutboundLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailboxId    String
  mailbox      OutboundMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  step         Int
  messageId    String          @unique
  toEmail      String
  subject      String
  body         String
  copySource   String          @default("fallback") // ai | fallback
  dryRun       Boolean         @default(false)
  sentAt       DateTime        @default(now())
  bounced      Boolean         @default(false)
  complained   Boolean         @default(false)
  replied      Boolean         @default(false)
  replySnippet String?
  kind         String          @default("sequence") // sequence | reply (Kly's answer to a prospect's reply)
  armIds       String[]        @default([])

  @@index([mailboxId, sentAt])
  @@index([leadId])
}

/// Never email these again: value = lowercased email or registrable domain.
model OutboundSuppression {
  id        String   @id @default(cuid())
  value     String   @unique
  kind      String // email | domain
  reason    String // bounce | unsubscribe | complaint | reply_stop | existing_user | manual
  createdAt DateTime @default(now())
}

/// Kly experiment arm: one variant of one dimension (subject, body, opener_style, ad_angle, followup, segment).
/// Kly assigns arms to leads (Thompson sampling), credits outcomes back, retires losers and breeds new arms with AI.
model KlyArm {
  id              String    @id @default(cuid())
  dimension       String // subject | body | opener_style | ad_angle | followup | segment
  key             String // short human label
  content         Json // the variant itself (template text, angle brief, {niche, city} ...)
  status          String    @default("active") // active | champion | retired
  origin          String    @default("seed") // seed | ai | manual
  parentId        String?
  rationale       String? // why Kly created it
  assigned        Int       @default(0)
  sends           Int       @default(0)
  clicks          Int       @default(0)
  replies         Int       @default(0)
  positiveReplies Int       @default(0)
  signups         Int       @default(0)
  paid            Int       @default(0)
  revenueCents    Int       @default(0)
  costMicros      BigInt    @default(0)
  retiredAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([dimension, key])
  @@index([dimension, status])
}

/// Kly safeguards and knobs (single row id = "kly"). Edited in /admin/ads/outbound; read every tick.
model KlySettings {
  id                 String   @id @default("kly")
  enabled            Boolean  @default(true) // master switch (sending also needs mailboxes + OUTBOUND_ENABLED=1)
  autoScale          Boolean  @default(true)
  dailySendCeiling   Int      @default(80) // across all mailboxes, after warm-up limits
  dailyGiftCap       Int      @default(40) // hook ads started per day
  monthlyBudgetCents Int      @default(30000) // AI + generation spend cap per calendar month
  maxCodexWeeklyPct  Int      @default(60) // stop starting gifts above this share of the Codex weekly window
  minLeadScore       Int      @default(55)
  minQualityScore    Int      @default(7)
  followUpDays       Int      @default(4)
  maxSteps           Int      @default(2)
  autoReply          Boolean  @default(true)
  explorationPct     Int      @default(20)
  targetCountries    String[] @default(["US"])
  voiceEnabled       Boolean  @default(false) // hand leads to The Tribunal for AI voice calls
  dailyCallCap       Int      @default(1000) // leads pushed to The Tribunal per day
  hourlyCallCap      Int      @default(100) // Tribunal call rate; Kly keeps at most ~1.5x this queued ahead
  voiceCursor        Int      @default(0) // last processed Tribunal bridge event id
  sources            String[] @default(["osm", "search", "codex_search"]) // lead sources discovery may use (osm | search | codex_search)
  discoveryPerTick   Int      @default(40) // max new leads per discovery tick when voice calling is on (email-only: 10)
  codexSearchPerTick Int      @default(1) // Codex web-search calls per discovery tick (also stopped by budget / maxCodexWeeklyPct)
  sourceStats        Json     @default("{}") // { blocks: { ddg|bing|codex: { until, reason, strikes } } } (yields: KlySourceYield)
  warmupEnabled      Boolean  @default(true) // peer warm-up between the rented mailboxes (kly/src/warmup.ts)
  warmupPerDay       Int      @default(40) // warm-up emails per mailbox per day (incl. replies; max 80)
  warmupGmailCap     Int      @default(25) // max warm-up emails each Gmail box receives per day (0 = none); Gmail never sends warm-up
  warmupReplyPct     Int      @default(35) // share of received warm-up mail answered in-thread
  warmupMinDays      Int      @default(14) // warm-up days before a mailbox may send cold
  warmupReadySpamPct Int      @default(10) // 7-day warm-up spam placement must be under this to send cold
  warmupPauseSpamPct Int      @default(25) // above this, cold sending is auto-paused (warm-up continues)
  notes              String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// One peer warm-up email between two Kly mailboxes (kly/src/warmup.ts). The receiver's IMAP pass records where it
/// landed (inbox | spam | missing), rescues it from spam, reads/stars it, files it into "Warmup" and maybe replies.
model KlyWarmupMessage {
  id              String    @id @default(cuid())
  messageId       String    @unique
  threadId        String // root Message-ID of the thread
  depth           Int       @default(1) // 1 = thread start, 2+ = replies
  maxDepth        Int       @default(1) // thread length chosen at start (1-3)
  senderId        String
  recipientId     String
  senderDomain    String
  recipientDomain String
  subject         String
  sentAt          DateTime  @default(now())
  placement       String? // inbox | spam | missing
  seenAt          DateTime?
  rescuedAt       DateTime?
  flaggedAt       DateTime?
  filedAt         DateTime?
  replyWanted     Boolean   @default(false)
  repliedAt       DateTime?
  kind            String    @default("warmup") // warmup | probe (copy of a real cold email to our own inbox: placement check)
  format          String? // probe: html | plain

  @@index([senderId, sentAt])
  @@index([kind, sentAt])
  @@index([recipientId, sentAt])
  @@index([recipientId, replyWanted, repliedAt])
  @@index([sentAt])
}

/// Kly's journal: every autonomous change it makes and why (scale up/down, new/retired arms, pauses, insights).
model KlyDecision {
  id        String   @id @default(cuid())
  kind      String // scale | arm_new | arm_retire | champion | segment | pause | resume | insight | budget | error
  summary   String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

/// Per-day rollup written by Kly (dashboard charts; idempotent upsert per day).
model KlyDaily {
  day           DateTime @id @db.Date
  found         Int      @default(0)
  qualified     Int      @default(0)
  giftsMade     Int      @default(0)
  giftsRejected Int      @default(0)
  sent          Int      @default(0)
  clicks        Int      @default(0)
  replies       Int      @default(0)
  positive      Int      @default(0)
  signups       Int      @default(0)
  paid          Int      @default(0)
  revenueCents  Int      @default(0)
  costMicros    BigInt   @default(0)
  bounces       Int      @default(0)
  complaints    Int      @default(0)
  calls         Int      @default(0)
  giftYes       Int      @default(0)
  voiceOptOuts  Int      @default(0)
  updatedAt     DateTime @updatedAt
}

/// Kly's own US business list: Overture Maps Places with a website, mapped to Kly niches (kly/scripts/import-places.ts).
/// Source "overture" hands out unused rows per niche + city and stamps usedAt. Data: CDLA-Permissive-2.0 / Apache-2.0.
model KlyPlace {
  id         String    @id // Overture GERS id
  niche      String
  category   String // Overture taxonomy.primary
  name       String
  website    String
  domain     String
  phone      String?
  city       String
  cityKey    String // lower-cased locality
  state      String
  postcode   String?
  lon        Float?
  lat        Float?
  confidence Float     @default(0)
  release    String // Overture release it came from (fsq: "fsq-<dt>")
  source     String    @default("overture") // overture | fsq
  email      String? // listed business email (fsq), lets the finder skip the site crawl
  usedAt     DateTime? // handed to the finder
  createdAt  DateTime  @default(now())

  @@index([niche, cityKey, state, usedAt])
  @@index([domain])
}

/// Kly lead-source yield per source|niche|city (finder picks sources by yield, skips exhausted segments).
model KlySourceYield {
  key        String   @id // "<source>|<niche>|<city>"
  source     String // osm | search | codex_search
  niche      String
  city       String
  runs       Int      @default(0)
  candidates Int      @default(0) // returned by the source
  fresh      Int      @default(0) // not already a lead / suppressed / customer
  leads      Int      @default(0) // qualified leads created
  dry        Int      @default(0) // consecutive runs with 0 fresh candidates
  lastRunAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([niche])
}

/// Komendly-side audit trail of Tribunal voice-bridge events (tribunalEventId unique = idempotent ingestion).
model OutboundVoiceEvent {
  id              String   @id @default(cuid())
  leadId          String? // null for workspace-level events (e.g. paused)
  tribunalEventId Int      @unique
  type            String
  email           String?
  detail          String?
  callId          String?
  delivery        String? // v1.1: "sms" | "email" | null (gift_yes / info_requested)
  smsPhone        String? // v1.1: E.164 number the recipient asked to be texted at
  at              DateTime
  createdAt       DateTime @default(now())

  @@index([leadId])
  @@index([type, at])
}

/// Shared ChatGPT (Codex) OAuth tokens for the engine and Kly (id = "codex"). Refresh tokens rotate, so both
/// services must refresh through this row under a Postgres advisory lock. Tokens are AES-GCM encrypted with ADS_TOKEN_KEY.
model CodexCredential {
  id           String   @id @default("codex")
  accessToken  String // encrypted
  refreshToken String // encrypted
  expiresAt    BigInt // epoch ms
  accountId    String?
  refreshedBy  String?
  updatedAt    DateTime @updatedAt
}

/// Ozzy Ad Coach check-up: the user uploads Meta Ads Manager screenshots or a CSV/XLSX export, the engine
/// (AdJob coach_review) writes a plain-words verdict. moreRunId = the "Make 5 more like the winner" run (seeded from verdict.winner).
model AdCoachReview {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  status      String    @default("uploading") // uploading | queued | working | ready | failed
  kind        String // table | screenshots
  files       Json      @default("[]") // [{key, mime, bytes, name}]
  note        String?
  verdict     Json? // CoachVerdictSchema (src/lib/ads/coach/contracts.ts)
  error       String?
  free        Boolean   @default(false) // the one free review of a non-Ad-Department paid plan
  moreRunId   String?   @unique
  costMicros  BigInt    @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, createdAt])
}

/// Ozzy Ad Department bonuses (one row per workspace + kind, latest version): website_checkup | ad_plan | hook_library.
/// Generated by the engine (job bonus_generate); data is the zod-validated output in src/lib/ads/bonuses/contracts.ts.
model AdsBonus {
  id             String    @id @default(cuid())
  workspaceId    String
  kind           String // website_checkup | ad_plan | hook_library
  status         String    @default("pending") // pending | generating | ready | failed (data keeps the last good version)
  data           Json?
  brandProfileId String?
  reason         String? // initial | monthly | new_ads | rerun | retry | stuck
  error          String?
  version        Int       @default(0)
  costMicros     BigInt    @default(0)
  generatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, kind])
  @@index([kind, status])
}
